{
  "code-freeze-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file|run_command|view_file|read_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/code-freeze-guard.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
